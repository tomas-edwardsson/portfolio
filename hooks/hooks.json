{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/regen.mts"],
            "timeout": 15,
            "statusMessage": "Regenerating portfolio views..."
          }
        ]
      }
    ]
  }
}
